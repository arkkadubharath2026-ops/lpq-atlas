# LPQ Atlas: OPTIONAL local settings. Nothing here is required; with no .env everything uses the defaults below.
#
# To change a setting:  copy this file to .env  (cp .env.example .env), uncomment a line, edit it.
# .env is git-ignored. scripts/setup/*.sh and *.ps1 read it (only ATLAS_* and LPQ_* keys; a variable that is
# already set in your environment wins), and so does `docker compose`. It holds no secrets and none are needed.

# --- ports (defaults shown) ---------------------------------------------------------
# ATLAS_API_PORT=8000
# ATLAS_WEB_PORT=3000

# --- API limits (defaults shown; see docs/atlas/README.md) ---------------------------
# ATLAS_MAX_JOBS=2             concurrent engine jobs
# ATLAS_RUN_TIMEOUT_S=180      one run
# ATLAS_BENCHMARK_TIMEOUT_S=1800

# --- build (read by setup) --------------------------------------------------------------
# LPQ_JOBS=4                   build parallelism
# LPQ_USE_SYSTEM_GTEST=1       use an installed GoogleTest instead of downloading it
# LPQ_SETUP_PYTHON=python3.13  interpreter to create .venv with
