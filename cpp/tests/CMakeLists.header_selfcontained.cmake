# ==============================================================================
# Header self-containment (ESD.md section 40: "all modules compile independently").
#
# Every public header is compiled ALONE, as the only thing in a translation
# unit. A header that silently depends on something another header happened to
# include first passes every other test in this project: the test suites include
# several headers at once, in an order that works, and the defect only appears
# when somebody includes that header first in a new file.
#
# This is a compile-time check with no runtime component. There is nothing to
# assert -- the build either succeeds or the header is not self-contained -- so
# it is a build target rather than a GoogleTest case.
#
# One generated .cpp per header, each containing exactly:
#
#     #include "lpq/<path>.hpp"
#     #include "lpq/<path>.hpp"      // again: proves the include guard works
#
# The second include is not redundant. A header missing its guard, or carrying a
# guard macro copied from another file, compiles fine once and fails on the
# second inclusion -- and a duplicated guard macro is silent in a way that
# removes a header's contents rather than erroring.
# ==============================================================================

file(GLOB_RECURSE LPQ_PUBLIC_HEADERS
     RELATIVE "${CMAKE_SOURCE_DIR}/cpp/include"
     "${CMAKE_SOURCE_DIR}/cpp/include/lpq/*.hpp")

if(NOT LPQ_PUBLIC_HEADERS)
    message(FATAL_ERROR
        "no public headers were found. The self-containment check would pass "
        "vacuously, which is worse than not having it.")
endif()

set(LPQ_SELFCONTAINED_SOURCES "")
foreach(header IN LISTS LPQ_PUBLIC_HEADERS)
    string(REPLACE "/" "_" stem "${header}")
    string(REPLACE ".hpp" "" stem "${stem}")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/selfcontained/${stem}.cpp")

    file(WRITE "${generated}"
         "// Generated by cpp/tests/CMakeLists.header_selfcontained.cmake.\n"
         "// Included twice on purpose: the second include proves the guard works.\n"
         "#include \"${header}\"\n"
         "#include \"${header}\"\n")

    list(APPEND LPQ_SELFCONTAINED_SOURCES "${generated}")
endforeach()

list(LENGTH LPQ_PUBLIC_HEADERS LPQ_HEADER_COUNT)
message(STATUS "header self-containment: ${LPQ_HEADER_COUNT} headers")

# A library rather than an executable: there is no main() and none is wanted.
add_library(test_header_selfcontained STATIC ${LPQ_SELFCONTAINED_SOURCES})
target_link_libraries(test_header_selfcontained PRIVATE
    lpq::common
    lpq::graph
    lpq::pq
    lpq::features
    lpq::models
    lpq::lpq
    lpq::verification
    lpq::adaptation
    lpq::metrics
    lpq::algorithms
    lpq::compiler_settings)

# Registered with ctest so a broken header fails the suite rather than only the
# build, which is what makes it visible in the same place as every other check.
add_test(NAME HeaderSelfContainment
         COMMAND "${CMAKE_COMMAND}" --build "${CMAKE_BINARY_DIR}"
                 --target test_header_selfcontained)
set_tests_properties(HeaderSelfContainment PROPERTIES LABELS "unit")
